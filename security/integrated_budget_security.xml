<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_integrated_budgets"
            model="res.groups.privilege">
        <field name="name">Integrated Budgets</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">80</field>
    </record>

    <record id="group_department_budget_user" model="res.groups">
        <field name="name">Department Budget User</field>
        <field name="privilege_id"
               ref="acme_integrated_budget.res_groups_privilege_integrated_budgets"/>
        <field name="sequence">10</field>
        <field name="implied_ids"
               eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_corporate_budget" model="res.groups">
        <field name="name">Corporate Budget Office</field>
        <field name="privilege_id"
               ref="acme_integrated_budget.res_groups_privilege_integrated_budgets"/>
        <field name="sequence">20</field>
        <field name="implied_ids"
               eval="[(4, ref('account.group_account_readonly'))]"/>
        <field name="implied_by_ids"
               eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- Department users: own department records -->
    <record id="department_budget_user_rule" model="ir.rule">
        <field name="name">Department users: own budgets</field>
        <field name="model_id" ref="model_acme_department_budget"/>
        <field name="groups" eval="[(4, ref('group_department_budget_user'))]"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            ('department_id.budget_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="department_budget_line_user_rule" model="ir.rule">
        <field name="name">Department users: own budget lines</field>
        <field name="model_id" ref="model_acme_department_budget_line"/>
        <field name="groups" eval="[(4, ref('group_department_budget_user'))]"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            ('budget_id.department_id.budget_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="department_month_plan_user_rule" model="ir.rule">
        <field name="name">Department users: own monthly plans</field>
        <field name="model_id" ref="model_acme_budget_month_plan"/>
        <field name="groups" eval="[(4, ref('group_department_budget_user'))]"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            ('budget_id.department_id.budget_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="department_budget_report_user_rule" model="ir.rule">
        <field name="name">Department users: own budget reports</field>
        <field name="model_id" ref="model_acme_budget_department_report"/>
        <field name="groups" eval="[(4, ref('group_department_budget_user'))]"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            ('department_id.budget_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="department_budget_category_summary_user_rule" model="ir.rule">
        <field name="name">Department users: own category summaries</field>
        <field name="model_id" ref="model_acme_budget_category_summary"/>
        <field name="groups" eval="[(4, ref('group_department_budget_user'))]"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            ('department_id.budget_user_ids', 'in', [user.id])
        ]</field>
    </record>

    <!-- Corporate office: company-scoped records -->
    <record id="corporate_department_budget_rule" model="ir.rule">
        <field name="name">Corporate office: company budgets</field>
        <field name="model_id" ref="model_acme_department_budget"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_department_budget_line_rule" model="ir.rule">
        <field name="name">Corporate office: company budget lines</field>
        <field name="model_id" ref="model_acme_department_budget_line"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_month_plan_rule" model="ir.rule">
        <field name="name">Corporate office: company monthly plans</field>
        <field name="model_id" ref="model_acme_budget_month_plan"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_budget_report_rule" model="ir.rule">
        <field name="name">Corporate office: company budget reports</field>
        <field name="model_id" ref="model_acme_budget_department_report"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_budget_category_summary_rule" model="ir.rule">
        <field name="name">Corporate office: company category summaries</field>
        <field name="model_id" ref="model_acme_budget_category_summary"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_budget_rule" model="ir.rule">
        <field name="name">Corporate office: company consolidations</field>
        <field name="model_id" ref="model_acme_corporate_budget"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_budget_variance_analysis_rule" model="ir.rule">
        <field name="name">Corporate office: company budget analyses</field>
        <field name="model_id" ref="model_acme_budget_variance_analysis"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corporate_budget_variance_analysis_line_rule" model="ir.rule">
        <field name="name">Corporate office: company budget analysis lines</field>
        <field name="model_id" ref="model_acme_budget_variance_analysis_line"/>
        <field name="groups" eval="[(4, ref('group_corporate_budget'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
